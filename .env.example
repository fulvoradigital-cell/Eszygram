# ==============================================================================
# Creator Revenue OS - Environment Configuration (.env.example)
# A high-performance SuperProfile / Stan Store alternative for Indian creators.
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Deployment Settings
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Connection string with credentials and database name
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/creator_revenue_os?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-character-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Provider
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Payments & Checkout (Razorpay - Tailored for UPI & Indian Payment Rails)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Platform Fee Percentage (e.g. 5 for 5% platform fee, 0 for 0%)
PLATFORM_FEE_PERCENT=5

# ------------------------------------------------------------------------------
# Transactional Emails (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Creator Revenue OS <notifications@creatorrevenueos.com>

# ------------------------------------------------------------------------------
# Cloud Object Storage (AWS S3 or Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=r2 # or s3
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=creator-digital-products
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_DOMAIN=https://assets.yourcreatoros.com

# ------------------------------------------------------------------------------
# Social Integrations & Instagram/Meta Creator Graph API
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
